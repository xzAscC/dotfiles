set highlight-color "rgba(255,245,180,0.25)"
set highlight-active-color "rgba(255,210,120,0.35)"
set selection-notification true
set selection-clipboard clipboard
set synctex true
set synctex-editor-command "nvim --server /tmp/nvimtex.sock --remote +%l %f"

# Reading captures via ~/.config/nvim/scripts/zathura-todo
# t     = 划词: clipboard selection → ~/JD/20 Anki/20.01 LANG/todo.md
# T     = comment/idea (rofi/zenity) → <book-dir>/note.md § Comments & Bookmarks
# <C-t> = page bookmark              → <book-dir>/note.md § Comments & Bookmarks
map t exec "/home/xzascc/.config/nvim/scripts/zathura-todo \"$FILE\" $PAGE clip"
map T exec "/home/xzascc/.config/nvim/scripts/zathura-todo \"$FILE\" $PAGE prompt"
map <C-t> exec "/home/xzascc/.config/nvim/scripts/zathura-todo \"$FILE\" $PAGE stamp"
