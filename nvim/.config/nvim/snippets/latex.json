{
  "latex begin/end environment": {
    "prefix": "begin",
    "body": [
      "\\\\begin{${1:env}}",
      "\t$0",
      "\\\\end{${1}}"
    ],
    "description": "Insert a LaTeX begin/end environment"
  },
  "latex itemize environment": {
    "prefix": "itemize",
    "body": [
      "\\\\begin{itemize}",
      "\t\\item $0",
      "\\\\end{itemize}"
    ],
    "description": "Insert an itemize environment"
  },
  "latex enumerate environment": {
    "prefix": "enumerate",
    "body": [
      "\\\\begin{enumerate}",
      "\t\\item $0",
      "\\\\end{enumerate}"
    ],
    "description": "Insert an enumerate environment"
  },
  "latex item": {
    "prefix": "item",
    "body": "\\\\item $0",
    "description": "Insert a LaTeX item"
  }
}
