#!/usr/bin/env bash
# Capture reading notes from Zathura.
#
# Usage:
#   zathura-todo <file-path> <page> [mode]
#   mode: clip (default) | prompt | stamp
#
# Routing:
#   clip   (t)     — 划词 / selection quote → ~/JD/20 Anki/20.01 LANG/todo.md
#   prompt (T)     — comment / typed idea   → <book-dir>/note.md  (§ Comments & Bookmarks)
#   stamp  (C-t)   — page bookmark          → <book-dir>/note.md  (§ Comments & Bookmarks)
#
# Book dir = parent directory of the open file (epub/pdf). note.md is created if missing.
# Section heading (exact): ## Comments & Bookmarks  — appended at EOF if absent.

set -euo pipefail

FILE="${1:?file path required}"
PAGE="${2:?page required}"
MODE="${3:-clip}"

TODO_DIR="${ZATHURA_TODO_DIR:-$HOME/JD/20 Anki/20.01 LANG}"
TODO_FILE="${ZATHURA_TODO_FILE:-$TODO_DIR/todo.md}"

BOOK_DIR="$(cd -- "$(dirname -- "$FILE")" && pwd)"
NOTE_FILE="${ZATHURA_NOTE_FILE:-$BOOK_DIR/note.md}"
SECTION_HEAD="## Comments & Bookmarks"

BASE="$(basename -- "$FILE")"
TS="$(date '+%Y-%m-%d %H:%M')"

clip_get() {
  if [ -n "${WAYLAND_DISPLAY:-}" ] && command -v wl-paste >/dev/null 2>&1; then
    wl-paste -n 2>/dev/null || true
  elif command -v xclip >/dev/null 2>&1; then
    xclip -o -selection clipboard 2>/dev/null || true
  elif command -v xsel >/dev/null 2>&1; then
    xsel -ob 2>/dev/null || true
  fi
}

notify() {
  local msg="$1"
  if command -v notify-send >/dev/null 2>&1; then
    notify-send "zathura-todo" "$msg" 2>/dev/null || true
  fi
}

# Append formatted entry to path $1. Uses KIND, BODY_STYLE, NOTE, TS, BASE, PAGE.
write_entry() {
  local out="$1"
  {
    echo "- **${TS}** · \`${KIND}\` · \`${BASE}\` · p.${PAGE}"
    case "$BODY_STYLE" in
      quote)
        while IFS= read -r line || [ -n "$line" ]; do
          printf '  > %s\n' "$line"
        done <<<"$NOTE"
        ;;
      plain)
        while IFS= read -r line || [ -n "$line" ]; do
          printf '  %s\n' "$line"
        done <<<"$NOTE"
        ;;
      none) ;;
    esac
    echo
  } >>"$out"
}

# True if line is the comments & bookmarks heading (case-insensitive, flexible spaces).
is_section_head() {
  local line="$1"
  local norm
  norm="$(printf '%s' "$line" | sed -E 's/^[[:space:]]+//;s/[[:space:]]+$//' | tr '[:upper:]' '[:lower:]')"
  norm="$(printf '%s' "$norm" | sed -E 's/[[:space:]]+/ /g')"
  [ "$norm" = "## comments & bookmarks" ]
}

# True if line is a markdown ## heading.
is_h2() {
  [[ "$1" =~ ^##[[:space:]] ]]
}

# Append entry under SECTION_HEAD in note.md (create file/section as needed).
append_to_note_section() {
  local entry_file="$1"
  local tmp before after
  tmp="$(mktemp)"
  before="$(mktemp)"
  after="$(mktemp)"

  cleanup_note_tmps() {
    rm -f -- "$tmp" "$before" "$after"
  }
  trap cleanup_note_tmps RETURN

  if [ ! -f "$NOTE_FILE" ]; then
    {
      echo "# Note"
      echo
      echo "$SECTION_HEAD"
      echo
      cat -- "$entry_file"
    } >"$NOTE_FILE"
    return
  fi

  local line found=0 in_section=0 past_section=0
  : >"$before"
  : >"$after"

  while IFS= read -r line || [ -n "$line" ]; do
    if [ "$found" -eq 0 ] && is_section_head "$line"; then
      found=1
      in_section=1
      printf '%s\n' "$line" >>"$before"
      continue
    fi

    if [ "$in_section" -eq 1 ]; then
      if is_h2 "$line" && ! is_section_head "$line"; then
        in_section=0
        past_section=1
        printf '%s\n' "$line" >>"$after"
        continue
      fi
      printf '%s\n' "$line" >>"$before"
      continue
    fi

    if [ "$past_section" -eq 1 ]; then
      printf '%s\n' "$line" >>"$after"
    else
      printf '%s\n' "$line" >>"$before"
    fi
  done <"$NOTE_FILE"

  if [ "$found" -eq 0 ]; then
    {
      cat -- "$NOTE_FILE"
      if [ -s "$NOTE_FILE" ] && [ "$(tail -c1 -- "$NOTE_FILE" | wc -l)" -eq 0 ]; then
        printf '\n'
      fi
      if [ -s "$NOTE_FILE" ] && [ -n "$(tail -n1 -- "$NOTE_FILE")" ]; then
        echo
      fi
      echo "$SECTION_HEAD"
      echo
      cat -- "$entry_file"
    } >"$tmp"
    mv -- "$tmp" "$NOTE_FILE"
    tmp="$(mktemp)"
    return
  fi

  # Trim trailing blank lines from section body; leave one blank before new entry.
  local stripped
  stripped="$(mktemp)"
  awk '
    { lines[NR] = $0 }
    END {
      end = NR
      while (end > 0 && lines[end] ~ /^[ \t]*$/) end--
      for (i = 1; i <= end; i++) print lines[i]
      if (end > 0) print ""
    }
  ' "$before" >"$stripped"
  mv -- "$stripped" "$before"

  {
    cat -- "$before"
    cat -- "$entry_file"
    if [ -s "$after" ]; then
      first="$(head -n1 -- "$after" || true)"
      if [ -n "$first" ]; then
        echo
      fi
      cat -- "$after"
    fi
  } >"$tmp"
  mv -- "$tmp" "$NOTE_FILE"
  tmp="$(mktemp)"
}

append_to_todo() {
  local entry_file="$1"
  mkdir -p -- "$TODO_DIR"
  if [ ! -f "$TODO_FILE" ]; then
    {
      echo "# Reading TODO"
      echo
      echo "划词 inbox from Zathura (selection / quote only). Comments & bookmarks go to the book note.md."
      echo
      echo "Kind: \`quote\` = selection (t)"
      echo
    } >"$TODO_FILE"
  fi
  cat -- "$entry_file" >>"$TODO_FILE"
}

NOTE=""
KIND=""
BODY_STYLE=""

case "$MODE" in
  clip)
    KIND="quote"
    BODY_STYLE="quote"
    NOTE="$(clip_get | sed -e 's/[[:space:]]\+$//' -e 's/^[[:space:]]\+//')"
    if [ -z "$NOTE" ]; then
      notify "Clipboard empty — select text first"
      exit 1
    fi
    ;;
  prompt)
    KIND="note"
    BODY_STYLE="plain"
    if command -v rofi >/dev/null 2>&1; then
      NOTE="$(printf '' | rofi -dmenu -p "idea p${PAGE}" 2>/dev/null || true)"
    elif command -v zenity >/dev/null 2>&1; then
      NOTE="$(zenity --entry --title="zathura-todo" --text="Idea (p${PAGE}):" 2>/dev/null || true)"
    else
      notify "Need rofi or zenity for prompt mode"
      exit 1
    fi
    if [ -z "${NOTE// }" ]; then
      exit 0
    fi
    ;;
  stamp)
    KIND="mark"
    BODY_STYLE="none"
    NOTE=""
    ;;
  *)
    echo "unknown mode: $MODE (use clip|prompt|stamp)" >&2
    exit 2
    ;;
esac

ENTRY_FILE="$(mktemp)"
trap 'rm -f -- "$ENTRY_FILE"' EXIT
: >"$ENTRY_FILE"
write_entry "$ENTRY_FILE"

case "$MODE" in
  clip)
    append_to_todo "$ENTRY_FILE"
    notify "→ todo.md · [${KIND}] ${BASE} p.${PAGE}"
    ;;
  prompt|stamp)
    append_to_note_section "$ENTRY_FILE"
    notify "→ note.md · [${KIND}] ${BASE} p.${PAGE}"
    ;;
esac
